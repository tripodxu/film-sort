{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "film-sort",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }

  // D1 is optional at runtime. After creating the database, uncomment this
  // block and replace database_id before applying migrations and deploying.
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "film-sort",
  //     "database_id": "REPLACE_WITH_D1_DATABASE_ID",
  //     "migrations_dir": "migrations"
  //   }
  // ]
}
