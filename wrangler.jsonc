{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "film-sort",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  // 非敏感的内置 AI 配置随仓库同步（Dashboard 与 deploy 双向一致）；
  // AI_API_KEY 是 Secret 类型，用 Dashboard 或 `wrangler secret put` 管理，勿写进本文件。
  "vars": {
    "AI_API_URL": "https://token-plan-cn.xiaomimimo.com/v1",
    "AI_MODEL": "mimo-v2.5",
    "AI_PROTOCOL": "chat"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "film-sort",
      "database_id": "9d1b3291-8cfc-4ed1-94c4-7539afcfc6b2",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * 1"]
  }
}
